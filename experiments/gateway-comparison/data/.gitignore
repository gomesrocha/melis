# Keep the phase directory structure and synthetic examples; exclude real data.
#
# Real raw data (pilot/final), logs, manifests tied to real runs, and large
# result blobs stay LOCAL and are not pushed. Synthetic example CSVs under
# examples/ are explicitly allowed (they test the scripts, not evidence).

# Ignore everything by default inside phase dirs...
smoke/*
pilot/*
final/*

# ...but keep the directories and their READMEs/placeholders.
!smoke/.gitkeep
!pilot/.gitkeep
!final/.gitkeep

# Raw/large artifacts never pushed, wherever they appear here.
*.jsonl
*.log
*.ndjson

# The synthetic examples directory IS versioned (handled outside this ignore).
