# Melis AI Gateway - Exemplo de Rotas
# =====================================
# Copie este arquivo como routes.yaml e ajuste.
# Hot-reload: alterações são detectadas em ~5 segundos sem reiniciar.
#
# Cada rota define:
#   path     - URL que o cliente chama (ex: /v1/chat/completions)
#   method   - Método HTTP (POST)
#   provider - Nome do provedor (deve existir no config.yaml ou custom_providers)
#   model    - Modelo padrão (override do payload do cliente)
#   token_optimization - Configuração de compressão (opcional)
#   semantic_cache     - Cache de respostas por rota (opcional, opt-in)
#   guardrails         - Filtros de entrada/saída por rota (opcional, opt-in)

# Provedores customizados (não são os 5 built-in)
# Registre aqui qualquer provedor OpenAI-compatible
custom_providers:
  # - name: "grok"
  #   base_url: "https://api.x.ai/v1"
  #   api_format: "openai_compatible"
  # - name: "deepseek"
  #   base_url: "https://api.deepseek.com/v1"
  #   api_format: "openai_compatible"

routes:
  # ─── Embeddings (Ollama local) ──────────────────────────────────
  - path: "/v1/embeddings"
    method: "POST"
    provider: "ollama"
    model: "nomic-embed-text:latest"

  # Endpoint padrão (Ollama local)
  - path: "/v1/chat/completions"
    method: "POST"
    provider: "ollama"
    model: "llama3.2"
    token_optimization:
      strategy: "adaptive_trimming"
      max_history_messages: 20
      compress_above_tokens: 4096
      local_tokenizer: "cl100k_base"

  # ─── Exemplo: scoring semântico na compactação (experimental, opt-in) ───
  # Só vale para strategy semantic_guarded_trimming. Sem o campo = legado, sem
  # chamadas de embedding. Pesos provisórios, não calibrados. O texto das mensagens
  # candidatas (truncado em max_chars) é enviado ao Ollama de embeddings; com cache
  # semântico ativo na mesma rota há chamadas de embedding adicionais (sem reuso).
  # Ver docs/specs/phase-5-semantic-scoring.md.
  # - path: "/v1/chat/scored"
  #   method: "POST"
  #   provider: "ollama"
  #   model: "llama3.2"
  #   token_optimization:
  #     strategy: "semantic_guarded_trimming"
  #     compress_above_tokens: 4096
  #     semantic_scoring:
  #       mode: hybrid                # heuristic | embedding | hybrid
  #       semantic_weight: 0.5
  #       structural_weight: 0.5
  #       embedding_model: "nomic-embed-text"
  #       timeout_ms: 1500
  #       max_messages: 64
  #       tool_group_policy: preserve   # preserve (default) | eligible_for_removal
  #       budget:
  #         mode: legacy              # strict → 400 se o obrigatório não couber
  #         # max_context_tokens: 8192
  #         # output_reserve_tokens: 1024
  #         # formatting_overhead: openai_chat_estimate

  # ─── Exemplo: rota com cache semântico (opt-in) ─────────────────
  # Respostas são cacheadas por (rota + modelo + embedding da conversa).
  # Requer Redis (config.yaml) e um provedor Ollama para embeddings.
  # Fail-open: sem Redis/Ollama o cache desliga (warn + melis_cache_degraded),
  # sem impacto no caminho crítico.
  # - path: "/v1/chat/cached"
  #   method: "POST"
  #   provider: "ollama"
  #   model: "llama3.2"
  #   semantic_cache:
  #     enabled: true                  # default false
  #     scope: per_identity            # per_identity (padrão, isola por identidade) | shared
  #     similarity_threshold: 0.92     # cosseno mínimo p/ hit (aplicado no lookup)
  #     ttl_secs: 3600                 # TTL de toda entrada (obrigatório)
  #     max_entries: 1000              # máx. entradas por namespace (rota+modelo)
  #     embedding_model: "nomic-embed-text"

  # ─── Exemplo: rota com guardrails (opt-in) ──────────────────────
  # Regras bidirecionais de conteúdo. Regex usa a crate `regex` (tempo linear,
  # sem backtracking catastrófico / ReDoS; sem look-around/backreferences).
  # - path: "/v1/chat/guarded"
  #   method: "POST"
  #   provider: "ollama"
  #   model: "llama3.2"
  #   guardrails:
  #     fail_closed: false            # opcional; herda config.yaml se omitido
  #     rules:
  #       - name: "no-ssn"
  #         type: "regex"              # regex | keyword | prompt_injection_heuristic
  #         direction: "inbound"       # inbound | outbound | both
  #         action: "block"           # block | redact | warn
  #         pattern: "\\d{3}-\\d{2}-\\d{4}"
  #       - name: "mask-emails"
  #         type: "regex"
  #         direction: "outbound"
  #         action: "redact"
  #         pattern: "[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}"
  #       - name: "prompt-injection"
  #         type: "prompt_injection_heuristic"
  #         direction: "inbound"
  #         action: "warn"

  # Adicione mais rotas conforme necessário:
  # - path: "/v1/chat/openai"
  #   method: "POST"
  #   provider: "openai"
  #   model: "gpt-4o-mini"
  #   token_optimization:
  #     strategy: "adaptive_trimming"
  #     max_history_messages: 20
  #     compress_above_tokens: 4096
  #     local_tokenizer: "cl100k_base"

# ─── Modelos virtuais / aliases declarativos (Fase 6A, opcional) ──────
# Um alias mapeia um nome lógico para um ou mais destinos concretos.
# O cliente pede `model: "fast"` (ou `@fast` para forçar interpretação de alias).
# @nome desconhecido => 400 (nunca encaminhado como modelo concreto).
# Precedência: route.model (override) > alias do payload > concreto > default_model.
# default_model é usado só quando o cliente não envia modelo; não oculta um alias.
# allowed_models (por API key) é checado no nome pedido E no destino resolvido.
# Cache: alias de destino único usa o destino efetivo na chave; múltiplos destinos
# fazem bypass do cache nesta versão. GET /v1/models lista aliases + concretos
# declarados, respeita auth e filtra por allowed_models; não revela credenciais.
# Ver docs/specs/phase-6a-virtual-models.md.
#
# model_aliases:
#   - name: "fast"
#     targets:
#       - provider: "ollama"
#         model: "llama3.2"
#   - name: "team-default"
#     targets:
#       - provider: "openai"
#         model: "gpt-4o-mini"
#         weight: 3
#       - provider: "ollama"
#         model: "llama3.2"
#         weight: 1
#
# Exemplo de rota com default_model (em vez de model obrigatório):
# - path: "/v1/chat/flex"
#   method: "POST"
#   provider: "openai"
#   default_model: "gpt-4o-mini"   # usado só se o cliente não enviar modelo
